# Este archivo debe colocarse en el repositorio ISPC-WEB-2025/TodoStock-AppMovil
# en la ruta: .github/workflows/notify-roadmap.yml
#
# Requiere un Personal Access Token (PAT) con permisos de 'repo' guardado en los Secrets de
# TodoStock-AppMovil con el nombre: ROADMAP_DISPATCH_TOKEN

name: Notify Roadmap on Issue or PR Change

on:
  issues:
    types: [opened, edited, closed, reopened, assigned, unassigned, labeled, unlabeled]
  pull_request:
    types: [closed]

jobs:
  dispatch-to-roadmap:
    runs-on: ubuntu-latest
    steps:
      - name: Trigger Roadmap Rebuild
        env:
          GH_PAT: ${{ secrets.ROADMAP_DISPATCH_TOKEN }}
        run: |
          if [ -n "$GH_PAT" ]; then
            curl -X POST \
              -H "Accept: application/vnd.github.v3+json" \
              -H "Authorization: token $GH_PAT" \
              https://api.github.com/repos/ISPC-WEB-2025/TodoStock-Mobile-RoadMap/dispatches \
              -d '{"event_type":"update-roadmap"}'
            echo "✅ Notificación enviada al repositorio TodoStock-Mobile-RoadMap."
          else
            echo "⚠️ Secret ROADMAP_DISPATCH_TOKEN no configurado; omitiendo dispatch automático."
          fi
